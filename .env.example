ODDS_API_KEY=
# Free-tier key to swap back in when a paid month ends
ODDS_API_KEY_FREE=
SMTP_USER=
SMTP_APP_PASSWORD=
# Betting bankroll in dollars, so the plan shows stakes in dollars (optional)
BANKROLL=
# Optional: who gets every email (comma-separated, include yourself; default SMTP_USER), who gets only the
# emails with a bet to place now, and a name in front of the subject
REPORT_EMAIL_TO=
REPORT_EMAIL_BETS_TO=
REPORT_SUBJECT_PREFIX=
# Where files live: local (data/, the default) or s3 (needs S3_BUCKET; S3_ENDPOINT_URL for an S3 stand-in)
STORAGE_BACKEND=
S3_BUCKET=
S3_PREFIX=
S3_ENDPOINT_URL=
# The ledgers' database as a SQLAlchemy URL; for Postgres it starts postgresql+psycopg:// (default: SQLite in data/)
DATABASE_URL=
